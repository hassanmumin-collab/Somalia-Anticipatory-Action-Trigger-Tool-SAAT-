# SAAT Environment Variables
# Copy this file to .env and fill in your credentials
# .env is gitignored and should never be committed

# API Keys and Credentials
ACLED_KEY=your_acled_key_here
CDS_KEY=your_cds_key_here
CDSE_USERNAME=your_cdse_username
CDSE_PASSWORD=your_cdse_password
HAPI_APP_IDENTIFIER=your_hapi_app_identifier
# Or generate it locally from your own application name and email:
# python -c "from saat.panel import HAPIClient; print(HAPIClient.make_app_identifier('SAAT','you@example.org'))"

# Data URLs (defaults work for public sources)
FRRIMS_URL=http://frrims.faoswalim.org/rivers/levels
HAPI_URL=https://hapi.humdata.org/api/v2
CKAN_URL=https://data.humdata.org/api/3/action

# Logging
SAAT_VERBOSITY=INFO
